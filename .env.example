# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_DB=bookmyshow
POSTGRES_USER=bookmyshow
POSTGRES_PASSWORD=local_pg_password_change_me
POSTGRES_PORT=5432

DATABASE_URL=postgresql://bookmyshow:local_pg_password_change_me@localhost:5432/bookmyshow

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local_redis_password_change_me

# Seat holding
HOLD_TTL_SECONDS=300